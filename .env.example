# Copy this file to `.env.local` for local development.
# For the live site these two values are set as GitHub repository secrets instead
# (see docs/SETUP.md).
#
# Both values are safe to expose in the browser: access is controlled by the
# row level security rules in supabase/migrations. NEVER put a "service_role"
# key or any AI (Gemini) key in this file.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: where the "Upgrade" button leads (an email address or an https:// page).
VITE_UPGRADE_CONTACT=
